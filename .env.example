# Resend API key for the contact form. Use "test" locally/CI for the mock send path.
RESEND_API_KEY=test

# Public site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.mividadigital.co.uk

# Sender address — must be on a domain/subdomain verified in Resend.
CONTACT_FROM_EMAIL=hello@contact.mividadigital.co.uk

# Where contact enquiries are delivered.
CONTACT_TO_EMAIL=hello@mividadigital.co.uk
